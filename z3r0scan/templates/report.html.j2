<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>z3r0scan — {{ report.target }}</title>
<style>
  :root { color-scheme: dark; }
  body { font-family: system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
         background:#0d1117; color:#c9d1d9; margin:0; padding:2rem; }
  .wrap { max-width: 960px; margin: 0 auto; }
  h1 { color:#58a6ff; margin-bottom:.2rem; }
  h2 { border-bottom:1px solid #30363d; padding-bottom:.3rem; margin-top:2rem; }
  small { color:#8b949e; font-weight:normal; }
  .meta { color:#8b949e; margin-bottom:1rem; }
  .chips { margin:1rem 0; }
  .chip, .sev { color:#fff; padding:.15rem .55rem; border-radius:6px; font-size:.8rem; font-weight:600; }
  .chip { margin-right:.4rem; display:inline-block; margin-bottom:.3rem; }
  ul { list-style:none; padding:0; }
  li { padding:.45rem 0; border-bottom:1px solid #21262d; }
  .desc { color:#8b949e; font-size:.9rem; margin:.25rem 0 .3rem 3.4rem; }
  .detail { color:#8b949e; font-style:italic; }
  .none { color:#8b949e; }
  .ai { background:#161b22; border:1px solid #30363d; border-left:3px solid #58a6ff;
        border-radius:8px; padding:.6rem 1.1rem; margin:.5rem 0; }
  .ai h4, .ai h5, .ai h6 { color:#58a6ff; margin:.9rem 0 .3rem; border:0; }
  .ai ul { list-style:disc; padding-left:1.3rem; }
  .ai li { border:0; padding:.15rem 0; }
  .ai code { background:#0d1117; padding:.1rem .3rem; border-radius:4px; }
  footer { margin-top:3rem; color:#8b949e; font-size:.85rem; }
</style>
</head>
<body>
<div class="wrap">
  <h1>z3r0scan report</h1>
  <div class="meta">
    Target: <b>{{ report.target }}</b> · Duration: {{ d.duration }}s ·
    Top severity: <b>{{ d.top_severity|upper }}</b> · Generated: {{ generated }}
  </div>
  <div class="chips">
    {% for sev in ["critical","high","medium","low","info"] %}
      <span class="chip" style="background:{{ colors[sev] }}">{{ sev }}: {{ d.severity_counts[sev] }}</span>
    {% endfor %}
  </div>

  {% if ai_html %}
    <h2>🤖 AI analysis <small>(via {{ ai.provider }} · {{ ai.model }})</small></h2>
    <div class="ai">{{ ai_html|safe }}</div>
  {% endif %}

  {% for module in report.modules %}
    <h2>{{ module.module }} <small>(status: {{ module.status }})</small></h2>
    {% if module.detail %}<p class="detail">{{ module.detail }}</p>{% endif %}
    {% if module.findings %}
      <ul>
        {% for f in module.findings %}
          <li>
            <span class="sev" style="background:{{ colors[f.severity.value] }}">{{ f.severity.value|upper }}</span>
            {{ f.title }}
            {% if f.description %}<div class="desc">{{ f.description }}</div>{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="none">No findings.</p>
    {% endif %}
  {% endfor %}

  <footer>Generated by z3r0scan — for authorized security testing only.</footer>
</div>
</body>
</html>
